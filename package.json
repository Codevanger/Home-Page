{
  "name": "codevanger-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Igor Rybakov's Windows XP-style personal homepage",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.json --noEmit && vite build",
    "build:watch": "vite build --watch",
    "typecheck:watch": "tsc --project tsconfig.json --noEmit --watch",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run build && npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "8.20.0",
    "eslint": "^10.14.0",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "sass": "^1.80.0",
    "sass-embedded": "^1.108.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
